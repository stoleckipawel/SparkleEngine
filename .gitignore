*.db
*.db-shm
*.db-wal
.ilk
.pdb
.pdb/
**/*.pdb
.log
.LOG
.tmp
.cache

# Generated logs and measurement captures stay out of commits.
# If a performance investigation needs to be preserved, move the artifact to a
# deliberate docs/attachment location instead of committing it from logs/.
logs/.*
logs/*
logs/Scripts/.*
logs/Scripts/*
Projects/**/build/
Projects/**/logs/
