########################################################
# Visual Studio, CMake, and Editor Intermediate Files   #
########################################################
# Generated build roots used by this repository.
# Keep these rules path-based and intentional. Do not ignore folders by generic
# names everywhere, because this repository contains real source directories such
# as `Tools/Launcher/SparkleLauncher/Private/Build`.
/Build/
/build/
/build-*/
/bin/
/obj/
/bld/

# Generated artifact and package roots introduced by the release architecture.
/artifacts/
/dist/

# Project-local generated outputs.
Projects/**/build/
Projects/**/[Cc]ooked/
Projects/**/logs/
Projects/**/StreamlineLogs/

# Showcase source media is acquired explicitly through the launcher. Catalog,
# level, provenance, and conversion records remain tracked outside these roots.
/Projects/Showcase/Assets/Meshes/Bistro/
/Projects/Showcase/Assets/Meshes/SanMiguel/
/Projects/Showcase/Assets/Meshes/ModernSponza/
/Projects/Showcase/Assets/Meshes/JungleRuins/
/Projects/Showcase/Assets/Meshes/LPSHead/Publisher/
/Projects/Showcase/Assets/Meshes/CornellBox/Publisher/

# Build results accidentally emitted at the repository root.
# Nested source folders named Debug/Release are real code and must remain visible.
/[Dd]ebug*/
/[Dd]ebugPublic/
/[Rr]elease*/
/[Rr]eleases/
/x64/
/x86/
/[Aa][Rr][Mm]*/

# Keep shader debug include files tracked.
!Engine/Assets/Shaders/Debug/
!Engine/Assets/Shaders/Debug/ViewModes.hlsli

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
mono_crash.*

# Editor files
.history
imgui.ini
Projects/**/imgui.ini
.vscode/
.vscode/*.code-workspace
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json

# Visual Studio files
.vs/
.vs/*
.vs/.*
.vs/.vscode/*
.vs/.vscode/*.code-workspace
.vs/.vscode/settings.json
.vs/.vscode/tasks.json
.vs/.vscode/launch.json
.vs/.vscode/extensions.json

# Visual Studio versioned local folders
.vs20*/
.vs20*/*
.vs20*/.*
.vs20*/.vscode/*
.vs20*/.vscode/*.code-workspace
.vs20*/.vscode/settings.json
.vs20*/.vscode/tasks.json
.vs20*/.vscode/launch.json
.vs20*/.vscode/extensions.json

# CMake and build system files
*.vcxproj*
*.sln
*.slnx
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Database and temp files
*.db
*.db-shm
*.db-wal
.ilk
.pdb
.pdb/
**/*.pdb
.log
.LOG
.tmp
.cache
tmp_donut/
tmp_donut_repo/
tmp_streamline_sdk/

# Large third-party SDK downloads are declared by CMake and cached under
# build/_deps; keep ad-hoc local copies out of source.
/External/NVIDIA/*.zip

# Generated logs and measurement captures stay out of commits.
# If a performance investigation needs to be preserved, move the artifact to a
# deliberate docs/attachment location instead of committing it from logs/.
/logs/.*
/logs/*
/Saved/Captures/
